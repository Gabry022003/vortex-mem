#!/usr/bin/env bash
set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
LIB="$DIR/bin/libvortex.so"

if [ "$1" != "run" ]; then
    echo "Usage: $0 run [--ci|--headless|--no-ui] [--heavy] [--port <port>] <program> [args...]"
    exit 1
fi

shift

HEADLESS=0
HTTP_PORT="${VORTEX_HTTP_PORT:-8000}"
UDP_PORT="${VORTEX_UDP_PORT:-8001}"

while [ $# -gt 0 ]; do
    case "$1" in
        --ci|--headless|--no-ui)
            HEADLESS=1
            shift
            ;;
        --heavy)
            export VORTEX_RED_ZONES=1
            export VORTEX_QUARANTINE=1
            shift
            ;;
        --port|-p)
            HTTP_PORT="$2"
            shift 2
            ;;
        --udp-port)
            UDP_PORT="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -lt 1 ]; then
    echo "Error: No target program specified."
    echo "Usage: $0 run [--ci|--headless|--no-ui] [--heavy] [--port <port>] <program> [args...]"
    exit 1
fi

if [ ! -f "$LIB" ]; then
    echo "Vortex engine not found at $LIB. Please run 'make' first."
    exit 1
fi

REPORT_FILE="${VORTEX_OUTPUT:-$DIR/vortex_report.json}"

if [ "$HEADLESS" -ne 1 ] && [ ! -d "$DIR/frontend/dist" ]; then
    echo "Notice: Frontend build not found at $DIR/frontend/dist."
    echo "Falling back to Headless mode. (To enable web UI: cd frontend && npm install && npm run build)"
    HEADLESS=1
fi

if [ "$HEADLESS" -eq 1 ]; then
    echo "Running target program with Vortex (Headless/CI mode)..."
    set +e
    env LD_PRELOAD="$LIB" VORTEX_OUTPUT="$REPORT_FILE" VORTEX_UDP_PORT="$UDP_PORT" "$@"
    TARGET_EXIT_CODE=$?
    set -e

    if [ -f "$REPORT_FILE" ]; then
        echo "Report generated: $REPORT_FILE"
    else
        echo "Failed to generate report."
    fi
    exit $TARGET_EXIT_CODE
fi

if [ ! -f "$DIR/bin/vortex_server" ]; then
    echo "Vortex C-Server not found. Please run 'make' first."
    exit 1
fi

echo "Starting Live Telemetry C-Server on port $HTTP_PORT..."
"$DIR/bin/vortex_server" "$DIR/frontend/dist" --port "$HTTP_PORT" --udp-port "$UDP_PORT" &
SERVER_PID=$!

trap "kill $SERVER_PID 2>/dev/null || true" EXIT

sleep 1

URL="http://localhost:$HTTP_PORT"
echo "Opening Dashboard at $URL..."
if grep -qi microsoft /proc/version 2>/dev/null; then
    if command -v wslview > /dev/null 2>&1; then
        wslview "$URL" &
    elif command -v cmd.exe > /dev/null 2>&1; then
        cmd.exe /c start "$URL" 2>/dev/null &
    elif command -v powershell.exe > /dev/null 2>&1; then
        powershell.exe -c "Start-Process '$URL'" 2>/dev/null &
    elif command -v xdg-open > /dev/null 2>&1; then
        xdg-open "$URL" &
    fi
elif command -v xdg-open > /dev/null 2>&1; then
    xdg-open "$URL" &
elif command -v open > /dev/null 2>&1; then
    open "$URL" &
elif command -v start > /dev/null 2>&1; then
    start "$URL" &
fi

echo "Running target program with Vortex..."
set +e
env LD_PRELOAD="$LIB" VORTEX_OUTPUT="$REPORT_FILE" VORTEX_HTTP_PORT="$HTTP_PORT" VORTEX_UDP_PORT="$UDP_PORT" "$@"
TARGET_EXIT_CODE=$?
set -e

if [ -f "$REPORT_FILE" ]; then
    echo "Report generated: $REPORT_FILE"
    if [ -d "$DIR/frontend/dist" ] && [ "$REPORT_FILE" != "$DIR/frontend/dist/vortex_report.json" ]; then
        cp "$REPORT_FILE" "$DIR/frontend/dist/vortex_report.json" 2>/dev/null || true
    fi
    
    echo "Resolving symbols..."
    curl -s "$URL/resolve" > /dev/null || true
else
    echo "Failed to generate report."
fi

echo "Target exited with status $TARGET_EXIT_CODE. Dashboard remains open. Press Ctrl+C to stop."
wait $SERVER_PID
